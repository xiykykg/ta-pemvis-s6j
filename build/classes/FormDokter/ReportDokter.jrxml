	<parameter name="parameter1" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
     dokter.`id_dokter` AS dokter_id_dokter,
     dokter.`nama_dokter` AS dokter_nama_dokter,
     dokter.`id_spesialis` AS dokter_id_spesialis,
     dokter.`hari_praktek` AS dokter_hari_praktek,
     dokter.`jam_praktek` AS dokter_jam_praktek,
     spesialis.`id_spesialis` AS spesialis_id_spesialis,
     spesialis.`nama_spesialis` AS spesialis_nama_spesialis
FROM
     `spesialis` spesialis INNER JOIN `dokter` dokter ON spesialis.`id_spesialis` = dokter.`id_spesialis`]]>
	</queryString>
