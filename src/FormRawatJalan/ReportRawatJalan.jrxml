	<parameter name="parameter1" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
     rawat_jalan.`id_rawat_jalan` AS rawat_jalan_id_rawat_jalan,
     rawat_jalan.`kode_periksa` AS rawat_jalan_kode_periksa,
     rawat_jalan.`kode_obat` AS rawat_jalan_kode_obat,
     rawat_jalan.`jumlah_obat` AS rawat_jalan_jumlah_obat,
     rawat_jalan.`harga` AS rawat_jalan_harga,
     pasien.`id_pasien` AS pasien_id_pasien,
     pasien.`nama_pasien` AS pasien_nama_pasien,
     pasien.`jenis_kelamin` AS pasien_jenis_kelamin,
     pasien.`umur` AS pasien_umur,
     pasien.`alamat` AS pasien_alamat,
     pasien.`no_hp` AS pasien_no_hp,
     pemeriksaan.`kode_periksa` AS pemeriksaan_kode_periksa,
     pemeriksaan.`id_pasien` AS pemeriksaan_id_pasien,
     pemeriksaan.`id_dokter` AS pemeriksaan_id_dokter,
     pemeriksaan.`diagnosa` AS pemeriksaan_diagnosa,
     pemeriksaan.`tgl_periksa` AS pemeriksaan_tgl_periksa,
     obat.`kode_obat` AS obat_kode_obat,
     obat.`nama_obat` AS obat_nama_obat,
     obat.`jenis_obat` AS obat_jenis_obat,
     obat.`harga` AS obat_harga,
     dokter.`id_dokter` AS dokter_id_dokter,
     dokter.`nama_dokter` AS dokter_nama_dokter,
     dokter.`id_spesialis` AS dokter_id_spesialis,
     dokter.`hari_praktek` AS dokter_hari_praktek,
     dokter.`jam_praktek` AS dokter_jam_praktek
FROM
     `pemeriksaan` pemeriksaan INNER JOIN `rawat_jalan` rawat_jalan ON pemeriksaan.`kode_periksa` = rawat_jalan.`kode_periksa`
     INNER JOIN `pasien` pasien ON pemeriksaan.`id_pasien` = pasien.`id_pasien`
     INNER JOIN `dokter` dokter ON pemeriksaan.`id_dokter` = dokter.`id_dokter`
     INNER JOIN `obat` obat ON rawat_jalan.`kode_obat` = obat.`kode_obat`]]>
	</queryString>
